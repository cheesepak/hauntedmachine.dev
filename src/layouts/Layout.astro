---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import "../styles/global.css"; 

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title = "Haunted Machine | Design Engineer", description = "Design engineer, game developer, and graphic designer making games and web experiences.", image = "" } = Astro.props;
// https://ogp.me/ for social media sharing
// https://docs.astro.build/en/guides/integrations-guide/sitemap/ for sitemap 
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta property="og:title" content="{title}" />
		<meta property="og:description" content="Front End Developer + Multidisciplinary Designer" />
		<!-- <meta property="og:image" content={image} />-->
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<!-- Analytics -->
		<script data-goatcounter="https://hauntedmachine.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
	</body>
</html>

<style>
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	body {
		font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		line-height: 1.6;
		padding-inline: 1rem;
	}
	main {
		max-width: 100dvw;
		margin-inline: auto;
		padding: 1rem;
		min-height: 100dvh;
	}
</style>
