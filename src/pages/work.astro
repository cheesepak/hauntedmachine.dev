---
import { getCollection } from 'astro:content';

import Project from '../components/Project.astro';
import Layout from '../layouts/Layout.astro';
import TagList from '../components/TagList.astro';

const pageTitle = "Work | Haunted Machine";
const pageDescription = "Design Engineer making games and web experiences.";

const allProjects = await getCollection("work");
const sortedProjects = allProjects.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});
---

<Layout title={pageTitle} description={pageDescription}>
    <h1>Work</h1>
    <p>Lorem ipsum project time.</p>
    <TagList collectionName="work" pathSegment="work" />
    {
        sortedProjects.map((project) => (
            <Project url={`/work/${project.id}/`} title={project.data.title} description={project.data.description} tags={project.data.tags} />
        ))
    }
</Layout>


<style></style>